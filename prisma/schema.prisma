// Prisma схема для Империя Пицца
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// ФИЛИАЛЫ
// ═══════════════════════════════════════════════════════
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String
  lat       Float
  lng       Float
  hours     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  users     User[]
  orders    Order[]

  @@map("branches")
}

// ═══════════════════════════════════════════════════════
// ПОЛЬЗОВАТЕЛИ
// ═══════════════════════════════════════════════════════
model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String?
  
  // Роли: founder, admin, branch_manager, kitchen, delivery_manager, courier, waiter, cashier, customer
  role      String   @default("customer")
  
  // Telegram
  telegramId      String?  @unique
  telegramUsername String?
  
  // Филиал (для сотрудников)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  orders         Order[]
  bookings       Booking[]
  courierOrders  Order[]   @relation("CourierOrders")

  @@map("users")
}

// ═══════════════════════════════════════════════════════
// МЕНЮ
// ═══════════════════════════════════════════════════════
model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int      // В тиынах (1 сум = 100 тиын)
  image       String?
  
  // pizza, snacks, desserts, drinks
  category    String
  
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)
  isNew       Boolean  @default(false)
  isVeg       Boolean  @default(false)
  
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  orderItems  OrderItem[]

  @@map("menu_items")
}

// ═══════════════════════════════════════════════════════
// ЗАКАЗЫ
// ═══════════════════════════════════════════════════════
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  
  // Клиент
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  
  customerName    String
  customerPhone   String
  customerEmail   String?
  
  // Доставка / Самовывоз / В зале
  type            String   // delivery, pickup, dine_in
  
  // Адрес доставки (если type = delivery)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  
  // Филиал
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  
  // Курьер (если type = delivery)
  courierId       String?
  courier         User?    @relation("CourierOrders", fields: [courierId], references: [id])
  
  // Статус: pending, confirmed, preparing, ready, delivering, completed, cancelled
  status          String   @default("pending")
  
  // Оплата
  paymentMethod   String   // cash, card, online, click, payme, uzum
  paymentStatus   String   @default("pending") // pending, paid, failed, refunded
  transactionId   String?
  paidAt          DateTime?
  
  // Суммы
  subtotal        Int      // Сумма товаров
  deliveryFee     Int      @default(0)
  discount        Int      @default(0)
  total           Int
  
  // Промокод
  promoCode       String?
  
  // Комментарий
  comment         String?
  
  // Время
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  readyAt         DateTime?
  deliveredAt     DateTime?
  updatedAt       DateTime @updatedAt

  // Связи
  items           OrderItem[]

  @@map("orders")
}

// ═══════════════════════════════════════════════════════
// ПОЗИЦИИ ЗАКАЗА
// ═══════════════════════════════════════════════════════
model OrderItem {
  id         String    @id @default(cuid())
  
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  menuItemId String
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])
  
  name       String    // Название на момент заказа
  price      Int       // Цена на момент заказа
  quantity   Int
  
  createdAt  DateTime  @default(now())

  @@map("order_items")
}

// ═══════════════════════════════════════════════════════
// БРОНИРОВАНИЕ СТОЛИКОВ
// ═══════════════════════════════════════════════════════
model Booking {
  id         String   @id @default(cuid())
  
  // Клиент
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  
  name       String
  phone      String
  email      String?
  
  // Бронь
  date       DateTime
  time       String
  guests     Int
  
  // Статус: pending, confirmed, cancelled, completed
  status     String   @default("pending")
  
  comment    String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bookings")
}

// ═══════════════════════════════════════════════════════
// АКЦИИ И НОВОСТИ
// ═══════════════════════════════════════════════════════
model Promotion {
  id          String   @id @default(cuid())
  
  // promo, news
  type        String
  
  title       String
  description String?
  badge       String?
  image       String?
  
  // Для акций
  discount    Int?
  promoCode   String?
  
  isActive    Boolean  @default(true)
  
  startsAt    DateTime?
  endsAt      DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("promotions")
}
